# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Local dev default: sqlite:///portfolio.db
# Production: a Postgres URL, e.g.
#   postgresql://user:password@host:5432/dbname
# (postgres:// is also accepted and normalized automatically)
DATABASE_URL=sqlite:///portfolio.db

# File storage backend for uploaded images/files: "local" or "s3".
# Leave as "local" for development. On hosts with an ephemeral
# filesystem (Render, Railway, Heroku, etc.) use "s3" so uploads
# survive redeploys.
STORAGE_BACKEND=local

# Only required when STORAGE_BACKEND=s3:
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom/CDN base URL to serve uploads from instead of the
# default https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=

# Set to 1 once deployed behind a host/proxy that terminates TLS and
# forwards X-Forwarded-Proto correctly. Leave 0 for local dev (plain
# http) to avoid HTTPS redirect loops.
FORCE_HTTPS=0

# Optional: Sentry DSN for production error monitoring. Leave blank to
# disable Sentry entirely (default, no account needed for local dev).
SENTRY_DSN=

# Flask-Limiter's rate-limit counter storage. Default (in-memory) is
# fine for a single dev/gunicorn-worker process. If you run gunicorn
# with more than one worker in production, point this at Redis instead
# so all workers share the same counters, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Optional: email alert when a new contact message arrives (see
# notifications.py). Leave SMTP_HOST/NOTIFY_EMAIL blank to disable —
# messages always still save to the admin inbox regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
